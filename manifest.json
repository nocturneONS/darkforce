{
  "manifest_version": 2,
  "name": "myStyles",
  "version": "1.0",
  "description": "Moje lekkie rozszerzenie do CSS per domena dla Firefoxa",
  "permissions": [
    "storage",
    "activeTab",
    "<all_urls>"
  ],
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "myStyles"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
